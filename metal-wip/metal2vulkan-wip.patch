+    ]);
+    assert_eq!(summary.keys().collect::<Vec<_>>(), [3]);
+    assert_eq!(summary.host_keys().collect::<Vec<_>>(), [3, 1]);
+    assert_eq!(summary.host_written().collect::<Vec<_>>(), [3]);
