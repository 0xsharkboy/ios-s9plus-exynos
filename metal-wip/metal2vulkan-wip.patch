+fn untracked_host_accesses_survive_parts_and_joins_but_not_fences_only() {
+    let mut encoder = EncoderUses::new(true);
+    encoder.record(
+        TRANSFER,
+        &[Use::reads(1, false, bytes(0..64), copy_read())],
+        None,
+    );
+    encoder.split();
+    encoder.record(
+        TRANSFER,
+        &[Use::writes(2, false, bytes(0..64), copy_write())],
+        None,
