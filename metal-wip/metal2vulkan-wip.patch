new file mode 100644
index 0000000..8f7aae0
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/serialized_fetch.rs
@@ -0,0 +1,272 @@
+//! Exact, bounded framebuffer fetch through one triangle per draw and subpass barriers.
+//! Native ordered attachment access and pixel interlock retain their existing paths.
+//! This fallback is admitted only for single-sample, side-effect-free ordinary pipelines,
+//! no primitive ID input, and direct triangle lists with one instance. Other shapes still
+//! require native ordering. No Vulkan feature bit is synthesized.
+
+use crate::error::Error;
+use crate::render_target;
+use ash::vk;
+use metal2vulkan::device::VkFeature;
+use metal2vulkan::error::{Capability, Feature, Unsupported};
+use metal2vulkan::pipeline::{GraphicsState, RenderPipeline};
+use metal2vulkan::vk::{DrawCommand, PrimitiveTopology, SampleCountFlags};
+
+/// A command-count ceiling, not an allocation: draw parts are produced lazily.
+const MAX_TRIANGLES: u32 = 4096;
+
+pub(crate) fn needed(g: &GraphicsState) -> bool {
+    !g.input_attachments.is_empty() && !g.rasterization_order_attachment_access
+}
+
+pub(crate) fn unavailable() -> Error {
+    Error::Unsupported(Unsupported::needs(
+        Feature::FramebufferFetch,
+        Capability::Feature(VkFeature::RasterizationOrderColorAttachmentAccess),
+    ))
+}
+
+pub(crate) fn admits_graphics(g: &GraphicsState) -> bool {
+    g.rasterization_samples == SampleCountFlags::COUNT_1
+        && !g.vertex_writes_memory
+        && !g.fragment_writes_memory
+        && g.tessellation.is_none()
+        && g.mesh_records.is_none()
+        && g.fragment_imageblock.is_none()
+        && g.shadow_stencil.is_none()
+        && g.max_vertex_amplification_count == 1
+        && !g.declares_layer
+        && !g.writes_viewport_index
+}
+
+/// Check decorations structurally. Splitting resets PrimitiveId, including a member or
+/// decoration-group use, so any declaration of that builtin conservatively needs native ordering.
+fn primitive_id(words: &[u32]) -> bool {
+    let mut at = 5;
+    while at < words.len() {
+        let count = (words[at] >> 16) as usize;
+        let op = words[at] & 0xffff;
+        if count == 0 || count > words.len() - at {
+            return true;
+        }
+        // SPIR-V OpDecorate / OpMemberDecorate, Decoration::BuiltIn, BuiltIn::PrimitiveId.
+        if (op == 71 && count >= 4 && words[at + 2] == 11 && words[at + 3] == 7)
+            || (op == 72 && count >= 5 && words[at + 3] == 11 && words[at + 4] == 7)
+        {
+            return true;
+        }
+        at += count;
+    }
+    false
+}
+
+pub(crate) fn pipeline(
+    p: &RenderPipeline,
+    profile: &metal2vulkan::device::DeviceProfile,
+) -> Result<(), Error> {
+    if needed(&p.graphics)
+        && (profile.fragment().pixel_interlock
+            || !admits_graphics(&p.graphics)
+            || p.stages.iter().any(|stage| primitive_id(&stage.spirv)))
+    {
+        return Err(unavailable());
+    }
+    Ok(())
+}
+
+pub(crate) fn admits_draw(topology: PrimitiveTopology, restart: bool, draw: DrawCommand) -> bool {
+    if topology != PrimitiveTopology::TRIANGLE_LIST || restart {
+        return false;
+    }
+    let (count, start) = match draw {
+        DrawCommand::Draw {
+            vertex_count,
+            instance_count: 1,
+            first_vertex,
+            ..
+        } => (vertex_count, first_vertex),
+        DrawCommand::DrawIndexed {
+            index_count,
+            instance_count: 1,
+            first_index,
+            ..
+        } => (index_count, first_index),
+        _ => return false,
+    };
+    count.is_multiple_of(3) && count / 3 <= MAX_TRIANGLES && start.checked_add(count).is_some()
+}
+
+/// The checked draw's triangle at `at` vertices/indices. Preserve base vertex and instance.
+fn part(draw: DrawCommand, at: u32) -> DrawCommand {
+    match draw {
+        DrawCommand::Draw {
+            instance_count,
+            first_vertex,
+            first_instance,
+            ..
+        } => DrawCommand::Draw {
+            vertex_count: 3,
+            instance_count,
+            first_vertex: first_vertex + at,
+            first_instance,
+        },
+        DrawCommand::DrawIndexed {
+            index_count: _,
+            instance_count,
+            first_index,
+            vertex_offset,
+            first_instance,
+            index_type,
+            index_buffer_offset,
+        } => DrawCommand::DrawIndexed {
+            index_count: 3,
+            instance_count,
+            first_index: first_index + at,
+            vertex_offset,
+            first_instance,
+            index_type,
+            index_buffer_offset,
+        },
+        other => other,
+    }
+}
+
+/// # Safety
+/// `draw` passed `admits_draw`; `cb` records inside the compatible, single-view subpass,
+/// with the pipeline and its resources bound and retained. Its self-dependency covers the barriers.
+pub(crate) unsafe fn record(raw: &ash::Device, cb: vk::CommandBuffer, draw: DrawCommand) {
+    let count = match draw {
+        DrawCommand::Draw { vertex_count, .. } => vertex_count,
+        DrawCommand::DrawIndexed { index_count, .. } => index_count,
+        _ => return,
+    };
+    // Include the first barrier: an attachment loadOp CLEAR is a color-output write too.
+    // Include the last: a following ordinary draw must not overwrite an unfinished input read.
+    unsafe {
+        for at in (0..count).step_by(3) {
+            render_target::between_draws(raw, cb, 0);
+            match part(draw, at) {
+                DrawCommand::Draw {
+                    vertex_count,
+                    instance_count,
+                    first_vertex,
+                    first_instance,
+                } => raw.cmd_draw(
+                    cb,
+                    vertex_count,
+                    instance_count,
+                    first_vertex,
+                    first_instance,
+                ),
+                DrawCommand::DrawIndexed {
+                    index_count,
+                    instance_count,
+                    first_index,
+                    vertex_offset,
+                    first_instance,
+                    ..
+                } => raw.cmd_draw_indexed(
+                    cb,
+                    index_count,
+                    instance_count,
+                    first_index,
+                    vertex_offset,
+                    first_instance,
+                ),
+                _ => {}
+            }
+        }
+        if count != 0 {
+            render_target::between_draws(raw, cb, 0);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn splitting_keeps_vertex_and_instance_origins_and_is_bounded() {
+        let d = DrawCommand::Draw {
+            vertex_count: 6,
+            instance_count: 1,
+            first_vertex: 17,
+            first_instance: 29,
+        };
+        assert!(admits_draw(PrimitiveTopology::TRIANGLE_LIST, false, d));
+        assert_eq!(
+            part(d, 3),
+            DrawCommand::Draw {
+                vertex_count: 3,
+                instance_count: 1,
+                first_vertex: 20,
+                first_instance: 29
+            }
+        );
+        assert!(!admits_draw(PrimitiveTopology::TRIANGLE_STRIP, false, d));
+        assert!(!admits_draw(PrimitiveTopology::TRIANGLE_LIST, true, d));
+        assert!(!admits_draw(
+            PrimitiveTopology::TRIANGLE_LIST,
+            false,
+            DrawCommand::Draw {
+                vertex_count: 3 * (MAX_TRIANGLES + 1),
+                instance_count: 1,
+                first_vertex: 17,
+                first_instance: 29
+            }
+        ));
+        assert!(!admits_draw(
+            PrimitiveTopology::TRIANGLE_LIST,
+            false,
+            DrawCommand::Draw {
+                first_vertex: u32::MAX,
+                vertex_count: 6,
+                instance_count: 1,
+                first_instance: 29
+            }
+        ));
+        assert!(!admits_draw(
+            PrimitiveTopology::TRIANGLE_LIST,
+            false,
+            DrawCommand::Draw {
+                instance_count: 2,
+                vertex_count: 6,
+                first_vertex: 17,
+                first_instance: 29
+            }
+        ));
+    }
+    #[test]
+    fn indexed_splitting_keeps_binding_offset_and_signed_base_vertex() {
+        let draw = DrawCommand::DrawIndexed {
+            index_type: metal2vulkan::vk::IndexType::UINT16,
+            index_buffer_offset: 128,
+            index_count: 6,
+            instance_count: 1,
+            first_index: 11,
+            vertex_offset: -9,
+            first_instance: 23,
+        };
+        assert!(admits_draw(PrimitiveTopology::TRIANGLE_LIST, false, draw));
+        assert_eq!(
+            part(draw, 3),
+            DrawCommand::DrawIndexed {
+                index_type: metal2vulkan::vk::IndexType::UINT16,
+                index_buffer_offset: 128,
+                index_count: 3,
+                instance_count: 1,
+                first_index: 14,
+                vertex_offset: -9,
+                first_instance: 23
+            }
+        );
+    }
+    #[test]
+    fn primitive_id_and_malformed_modules_need_native_ordering() {
+        assert!(!primitive_id(&[0, 0, 0, 0, 0]));
+        assert!(primitive_id(&[0, 0, 0, 0, 0, 4 << 16 | 71, 42, 11, 7]));
+        assert!(primitive_id(&[0, 0, 0, 0, 0, 5 << 16 | 72, 42, 0, 11, 7]));
+        assert!(!primitive_id(&[0, 0, 0, 0, 0, 4 << 16 | 71, 42, 11, 0]));
+        assert!(primitive_id(&[0, 0, 0, 0, 0, 0]));
+    }
+}
