# SM-G975F / Exynos 9820: first kernel and raw-syscall PID 1 from RAM.
# Apply over beyond2lte_defconfig. The loader adds rd=md0 for the hello payload.
CONFIG_FIRMWARE="none"
# The kernel on the core UEFI runs on, which needs no PSCI CPU_ON: docs/beyond2lte-bringup.md, runs 4 and 5.
CONFIG_CPUS=1
# CONFIG_BOOTCPU is not set
# CONFIG_UFS is not set
# CONFIG_UFS_WRITE is not set
# CONFIG_VAR_STORE is not set
# CONFIG_VAR_HFS is not set
# CONFIG_GPU is not set
# CONFIG_WIFI is not set
# CONFIG_BT is not set
# CONFIG_MODEM is not set
# CONFIG_USB_GADGET is not set
