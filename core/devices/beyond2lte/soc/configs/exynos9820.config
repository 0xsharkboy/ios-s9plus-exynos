# HakiOS fragment: the Samsung Exynos 9820 (S5E9820) -- what is true of the SoC, whatever phone it is in.
# None of the common repository's SoC drivers is this SoC's: the Exynos ones have the 9810's addresses, the rest are Qualcomm's.
CONFIG_SOC="exynos9820"
# Two A55s, 2 and 3, the S9's choice: the kernel on a core of its own, the loader watching from core 0 and writing the log.
# Which core S-Boot leaves parked has not been seen here; cores of one type avoid mixing what the processors can do.
CONFIG_CPUS=2
CONFIG_BOOTCPU=2
